#!/usr/bin/env bash

#
# Install skills into AI agents: Claude Code, Pi, Cursor, GitHub Copilot.
#
# Select agents with --claude, --pi, --cursor, --copilot, or --all.
# These parameters do not accept values.
#
# The target directory is set once via --dir. It defaults to ~
# (user-level install). Pass any other path for a project-level install.
#
# For Claude and Pi: user-level installs are symlinks back into this repo
# (so local edits to skills are picked up immediately); project-level
# installs are hard copies (so the project is self-contained). Cursor and
# Copilot installs are always generated files, regardless of target.
#
# Cursor and Copilot may not auto-discover user-level skills. The script
# warns at the end of the run if either was installed at ~.
#
# See `--help` for more guidance.
#

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

repo_root="$(cd "${script_dir}/.." && pwd)"
readonly repo_root

readonly skills_dir="${repo_root}/skills"
readonly marker="<!-- Generated by kieranpotts/skills installer — do not edit; re-run install instead -->"
readonly copy_marker_file=".kp-skills-installer"

usage() {
  cat <<'EOF'
Usage: ./run/install [OPTIONS]

Install skills into AI agents. At least one agent flag (--claude, --pi,
--cursor, --copilot, or --all) is required.

Options:
  --claude              Install for Claude Code.
  --pi                  Install for Pi.
  --cursor              Install for Cursor.
  --copilot             Install for Copilot.
  --all                 Install for all four agents.
  --dir DIR             Target directory for all selected agents. Defaults
                        to ~ (user-level). Use any other path for a
                        project-level install. A leading ~ is expanded
                        to $HOME.
  --uninstall           Remove installs. Combine with target flags.
  --dry-run             Print outcomes without performing them.
  --help, -h            Show this help.

Target paths (relative to DIR):
  Claude:    DIR/.claude/skills/
  Pi:        DIR/.pi/skills/ (project) or ~/.pi/agent/skills/ (when DIR is ~)
  Cursor:    DIR/.cursor/rules/
  Copilot:   DIR/.github/instructions/

Notes:
  - For Claude and Pi: user-level installs (DIR is ~) are symlinks back
    into this repo, so edits to skills are picked up immediately. Project-
    level installs (any other DIR) are hard copies, so the project remains
    self-contained.
  - Cursor and Copilot installs are always generated files (.mdc and
    .instructions.md). Re-run the install script after editing skills to
    refresh them.
  - Cursor and Copilot typically only auto-discover skills in project
    directories. They are still installed when DIR is ~, but the installer
    prints a warning at the end of its run.
  - Uninstall only removes files this installer previously created
    (symlinks pointing back into this repo, copies bearing our marker
    file, or generated files containing our marker comment).

Examples:
  ./run/install --claude                       # Claude, user-level (default).
  ./run/install --claude --dir .               # Claude, into cwd.
  ./run/install --pi                           # Pi, user-level.
  ./run/install --all                          # All four, user-level (warns about Cursor/Copilot).
  ./run/install --all --dir ~/dev/my-project   # All four, into a specific project.
  ./run/install --cursor --dir .               # Cursor, into cwd.
  ./run/install --uninstall --claude           # Remove Claude user-level symlinks.
  ./run/install --uninstall --pi --dir .       # Remove Pi project-level copies from cwd.
EOF
}

discover_skills() {
  find "${skills_dir}" -mindepth 2 -maxdepth 2 -name SKILL.md -printf '%h\n' | sort
}

extract_description() {
  local skill_md="$1"
  awk '
    /^---$/ { c++; next }
    c == 1 && /^description:/ {
      sub(/^description:[[:space:]]*/, "")
      print
      exit
    }
  ' "${skill_md}"
}

extract_body() {
  local skill_md="$1"
  awk '
    BEGIN { c = 0 }
    /^---$/ { c++; next }
    c >= 2 { print }
  ' "${skill_md}"
}

expand_tilde() {
  local path="$1"
  case "${path}" in
    \~)    printf "%s" "${HOME}" ;;
    \~/*)  printf "%s/%s" "${HOME}" "${path:2}" ;;
    *)     printf "%s" "${path}" ;;
  esac
}

prune_empty_dir() {
  local dir="$1"
  local dry_run="$2"
  if [[ -d "${dir}" ]] && [[ -z "$(ls -A "${dir}" 2>/dev/null)" ]]; then
    printf "  - %s (empty)\n" "${dir}"
    [[ "${dry_run}" == "true" ]] || rmdir "${dir}"
  fi
}

# Install skills as symlinks pointing back into this repository. Used for
# user-level installs only, where the live link is desirable so that local
# edits to skills are picked up immediately by the agent.
install_symlinks() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target current
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      current="$(readlink "${target}")"
      if [[ "${current}" == "${skill_path}" ]]; then
        printf "  = %s (already linked)\n" "${skill_name}"
        continue
      fi
      printf "  ~ %s (updating symlink)\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || ln -sfn "${skill_path}" "${target}"
    elif [[ -e "${target}" ]]; then
      printf "  ! %s (skipping — exists and is not our symlink)\n" "${skill_name}" >&2
    else
      printf "  + %s\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || ln -sfn "${skill_path}" "${target}"
    fi
  done < <(discover_skills)
}

uninstall_symlinks() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target current
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      current="$(readlink "${target}")"
      if [[ "${current}" == "${skill_path}" ]]; then
        printf "  - %s\n" "${skill_name}"
        [[ "${dry_run}" == "true" ]] || rm "${target}"
      else
        printf "  ? %s (symlink, but not ours — skipping)\n" "${skill_name}" >&2
      fi
    fi
  done < <(discover_skills)

  prune_empty_dir "${target_dir}" "${dry_run}"
}

# Install skills as recursive copies of the source directory. Used for
# project-level installs, where the project should be self-contained and
# unaffected by changes (or deletion) of the upstream skills repository.
# A marker file (copy_marker_file) is dropped inside each copied directory
# so we can identify our own installs at uninstall time.
install_copies() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      printf "  ! %s (skipping — exists as a symlink, not our copy)\n" "${skill_name}" >&2
    elif [[ -d "${target}" ]]; then
      if [[ -f "${target}/${copy_marker_file}" ]]; then
        printf "  ~ %s (refreshing copy)\n" "${skill_name}"
        [[ "${dry_run}" == "true" ]] || {
          rm -rf "${target}"
          cp -R "${skill_path}" "${target}"
          : > "${target}/${copy_marker_file}"
        }
      else
        printf "  ! %s (skipping — exists and is not our copy)\n" "${skill_name}" >&2
      fi
    elif [[ -e "${target}" ]]; then
      printf "  ! %s (skipping — exists and is not a directory)\n" "${skill_name}" >&2
    else
      printf "  + %s\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || {
        cp -R "${skill_path}" "${target}"
        : > "${target}/${copy_marker_file}"
      }
    fi
  done < <(discover_skills)
}

uninstall_copies() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -d "${target}" && -f "${target}/${copy_marker_file}" ]]; then
      printf "  - %s\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || rm -rf "${target}"
    elif [[ -e "${target}" || -L "${target}" ]]; then
      printf "  ? %s (exists, but not our copy — skipping)\n" "${skill_name}" >&2
    fi
  done < <(discover_skills)

  prune_empty_dir "${target_dir}" "${dry_run}"
}

install_cursor() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target description
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.mdc"
    description="$(extract_description "${skill_path}/SKILL.md")"

    printf "  + %s.mdc\n" "${skill_name}"
    [[ "${dry_run}" == "true" ]] && continue

    {
      printf -- "---\n"
      printf "description: %s\n" "${description}"
      printf "alwaysApply: true\n"
      printf -- "---\n\n"
      printf "%s\n\n" "${marker}"
      extract_body "${skill_path}/SKILL.md"
    } > "${target}"
  done < <(discover_skills)
}

uninstall_cursor() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.mdc"

    if [[ -f "${target}" ]] && grep -qF "${marker}" "${target}"; then
      printf "  - %s.mdc\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || rm "${target}"
    fi
  done < <(discover_skills)

  prune_empty_dir "${target_dir}" "${dry_run}"
}

install_copilot() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.instructions.md"

    printf "  + %s.instructions.md\n" "${skill_name}"
    [[ "${dry_run}" == "true" ]] && continue

    {
      printf -- "---\n"
      printf 'applyTo: "**"\n'
      printf -- "---\n\n"
      printf "%s\n\n" "${marker}"
      extract_body "${skill_path}/SKILL.md"
    } > "${target}"
  done < <(discover_skills)
}

uninstall_copilot() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.instructions.md"

    if [[ -f "${target}" ]] && grep -qF "${marker}" "${target}"; then
      printf "  - %s.instructions.md\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || rm "${target}"
    fi
  done < <(discover_skills)

  prune_empty_dir "${target_dir}" "${dry_run}"
}

main() {
  # No arguments → show help and exit 0.
  if [[ $# -eq 0 ]]; then
    usage
    return 0
  fi

  local do_claude=false
  local do_pi=false
  local do_cursor=false
  local do_copilot=false
  local dir=""
  local uninstall=false
  local dry_run=false
  local any_flag=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude)
        do_claude=true; any_flag=true; shift ;;
      --pi)
        do_pi=true; any_flag=true; shift ;;
      --cursor)
        do_cursor=true; any_flag=true; shift ;;
      --copilot)
        do_copilot=true; any_flag=true; shift ;;
      --all)
        do_claude=true; do_pi=true; do_cursor=true; do_copilot=true
        any_flag=true; shift ;;
      --dir)
        shift
        if [[ $# -eq 0 ]]; then
          printf "Error: --dir requires a path argument.\n" >&2
          return 1
        fi
        dir="$(expand_tilde "$1")"
        shift ;;
      --uninstall)
        uninstall=true; shift ;;
      --dry-run)
        dry_run=true; shift ;;
      --help|-h)
        usage; return 0 ;;
      *)
        printf "Error: unknown option '%s'\n" "$1" >&2
        usage >&2
        return 1
        ;;
    esac
  done

  # At least one agent flag is required. --uninstall and --dry-run alone
  # are not enough to do anything useful, so error out with the help text.
  if [[ "${any_flag}" == "false" ]]; then
    printf "Error: at least one agent flag is required (--claude, --pi, --cursor, --copilot, or --all).\n\n" >&2
    usage >&2
    return 1
  fi

  # --dir defaults to $HOME (user-level install).
  dir="${dir:-${HOME}}"

  # Compute per-tool target paths. Pi's discovery contract uses two
  # different subpaths: ~/.pi/agent/skills/ for user-level and
  # .pi/skills/ for any other (project-level) DIR.
  local claude_target="${dir}/.claude/skills"
  local pi_target
  if [[ "${dir}" == "${HOME}" ]]; then
    pi_target="${dir}/.pi/agent/skills"
  else
    pi_target="${dir}/.pi/skills"
  fi
  local cursor_target="${dir}/.cursor/rules"
  local copilot_target="${dir}/.github/instructions"

  local action="Installing"
  [[ "${uninstall}" == "true" ]] && action="Uninstalling"
  [[ "${dry_run}" == "true" ]] && action="${action} (dry-run)"

  # For Claude and Pi: user-level installs use symlinks (so local edits to
  # the source repo are picked up immediately); project-level installs use
  # hard copies (so the project is self-contained and unaffected by changes
  # to the source repo).
  local install_fn="install_symlinks"
  local uninstall_fn="uninstall_symlinks"
  local mode_label="symlinks"
  if [[ "${dir}" != "${HOME}" ]]; then
    install_fn="install_copies"
    uninstall_fn="uninstall_copies"
    mode_label="copies"
  fi

  if [[ "${do_claude}" == "true" ]]; then
    printf "%s skills for Claude Code (%s): %s\n" "${action}" "${mode_label}" "${claude_target}"
    if [[ "${uninstall}" == "true" ]]; then
      "${uninstall_fn}" "${claude_target}" "${dry_run}"
    else
      "${install_fn}" "${claude_target}" "${dry_run}"
    fi
  fi

  if [[ "${do_pi}" == "true" ]]; then
    printf "%s skills for Pi (%s): %s\n" "${action}" "${mode_label}" "${pi_target}"
    if [[ "${uninstall}" == "true" ]]; then
      "${uninstall_fn}" "${pi_target}" "${dry_run}"
    else
      "${install_fn}" "${pi_target}" "${dry_run}"
    fi
  fi

  if [[ "${do_cursor}" == "true" ]]; then
    printf "%s skills for Cursor: %s\n" "${action}" "${cursor_target}"
    if [[ "${uninstall}" == "true" ]]; then
      uninstall_cursor "${cursor_target}" "${dry_run}"
    else
      install_cursor "${cursor_target}" "${dry_run}"
    fi
  fi

  if [[ "${do_copilot}" == "true" ]]; then
    printf "%s skills for Copilot: %s\n" "${action}" "${copilot_target}"
    if [[ "${uninstall}" == "true" ]]; then
      uninstall_copilot "${copilot_target}" "${dry_run}"
    else
      install_copilot "${copilot_target}" "${dry_run}"
    fi
  fi

  # Warn at the end if Cursor or Copilot were targeted at $HOME — those
  # agents may not auto-discover user-level skills.
  if [[ "${dir}" == "${HOME}" && "${uninstall}" == "false" ]]; then
    local subjects=""
    if [[ "${do_cursor}" == "true" && "${do_copilot}" == "true" ]]; then
      subjects="Cursor and Copilot"
    elif [[ "${do_cursor}" == "true" ]]; then
      subjects="Cursor"
    elif [[ "${do_copilot}" == "true" ]]; then
      subjects="Copilot"
    fi
    if [[ -n "${subjects}" ]]; then
      printf "\nWarning: %s may not auto-discover user-level skills (~). The files have been written but may not be picked up automatically.\n" "${subjects}" >&2
    fi
  fi
}

main "$@"
