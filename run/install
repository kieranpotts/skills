#!/usr/bin/env bash

#
# Install skills into AI tools (Claude Code, Pi, Cursor, GitHub Copilot).
#
# All four tools support per-project installs – skills/rules/instructions
# are placed inside a project's tool-specific directory. Claude and Pi
# additionally support user-level installs – pass `--claude ~` or
# `--pi ~`. See `--help`.
#

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

repo_root="$(cd "${script_dir}/.." && pwd)"
readonly repo_root

readonly skills_dir="${repo_root}/skills"
readonly marker="<!-- Generated by kieranpotts/skills installer — do not edit; re-run install instead -->"

usage() {
  cat <<'EOF'
Usage: ./run/install [OPTIONS]

Install skills into AI tools. With no flags, installs only for Claude Code
(into the current working directory's .claude/skills/).

Options:
  --claude [DIR]        Install for Claude Code. Adds symlinks into
                        DIR/.claude/skills/. Default DIR is cwd. Pass `~`
                        for user-level install at ~/.claude/skills/.
  --pi [DIR]            Install for Pi. Adds symlinks into
                        DIR/.pi/skills/. Default DIR is cwd. Pass `~`
                        for user-level install at ~/.pi/agent/skills/.
  --cursor [DIR]        Install for Cursor. Adds .mdc files into
                        DIR/.cursor/rules/. Default DIR is cwd.
  --copilot [DIR]       Install for Copilot. Adds .instructions.md files
                        into DIR/.github/instructions/. Default DIR is cwd.
  --all                 Install for all four. All default to cwd.
  --uninstall           Remove installs. Combine with target flags.
  --dry-run             Print actions without performing them.
  --help, -h            Show this help.

Notes:
  - Claude and Pi support user-level discovery. Cursor and Copilot only
    read from current project directories. You may supply "~" as the target
    directory for all tools, but beware that only Claude and Pi currently
    auto-discover user-level skills.
  - A leading `~` in any DIR is expanded to $HOME.
  - Cursor/Copilot files are generated, not symlinked like Claude's and Pi's.
    Re-run the `./run/install` script after editing skills to make your
    changes available to AI tools.
  - Uninstall only removes symlinks and files generated by this installer.

Examples:
  ./run/install                            # Claude only, into cwd.
  ./run/install --claude ~                 # Claude only, user-level.
  ./run/install --pi ~                     # Pi only, user-level.
  ./run/install --claude ~ --cursor        # Claude user-level + Cursor in cwd.
  ./run/install --cursor ~/my-project      # Cursor only, into a specific project.
  ./run/install --all --claude ~ --pi ~    # Claude and Pi global, Cursor/Copilot in cwd.
  ./run/install --uninstall --claude ~     # Remove Claude user-level symlinks.
  ./run/install --uninstall --pi ~         # Remove Pi user-level symlinks.
EOF
}

discover_skills() {
  find "${skills_dir}" -mindepth 2 -maxdepth 2 -name SKILL.md -printf '%h\n' | sort
}

extract_description() {
  local skill_md="$1"
  awk '
    /^---$/ { c++; next }
    c == 1 && /^description:/ {
      sub(/^description:[[:space:]]*/, "")
      print
      exit
    }
  ' "${skill_md}"
}

extract_body() {
  local skill_md="$1"
  awk '
    BEGIN { c = 0 }
    /^---$/ { c++; next }
    c >= 2 { print }
  ' "${skill_md}"
}

expand_tilde() {
  local path="$1"
  case "${path}" in
    \~)    printf "%s" "${HOME}" ;;
    \~/*)  printf "%s/%s" "${HOME}" "${path:2}" ;;
    *)     printf "%s" "${path}" ;;
  esac
}

install_claude() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target current
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      current="$(readlink "${target}")"
      if [[ "${current}" == "${skill_path}" ]]; then
        printf "  = %s (already linked)\n" "${skill_name}"
        continue
      fi
      printf "  ~ %s (updating symlink)\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || ln -sfn "${skill_path}" "${target}"
    elif [[ -e "${target}" ]]; then
      printf "  ! %s (skipping — exists and is not our symlink)\n" "${skill_name}" >&2
    else
      printf "  + %s\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || ln -sfn "${skill_path}" "${target}"
    fi
  done < <(discover_skills)
}

uninstall_claude() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target current
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      current="$(readlink "${target}")"
      if [[ "${current}" == "${skill_path}" ]]; then
        printf "  - %s\n" "${skill_name}"
        [[ "${dry_run}" == "true" ]] || rm "${target}"
      else
        printf "  ? %s (symlink, but not ours — skipping)\n" "${skill_name}" >&2
      fi
    fi
  done < <(discover_skills)

  if [[ -d "${target_dir}" ]] && [[ -z "$(ls -A "${target_dir}" 2>/dev/null)" ]]; then
    printf "  - %s (empty)\n" "${target_dir}"
    [[ "${dry_run}" == "true" ]] || rmdir "${target_dir}"
  fi
}

install_pi() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target current
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      current="$(readlink "${target}")"
      if [[ "${current}" == "${skill_path}" ]]; then
        printf "  = %s (already linked)\n" "${skill_name}"
        continue
      fi
      printf "  ~ %s (updating symlink)\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || ln -sfn "${skill_path}" "${target}"
    elif [[ -e "${target}" ]]; then
      printf "  ! %s (skipping — exists and is not our symlink)\n" "${skill_name}" >&2
    else
      printf "  + %s\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || ln -sfn "${skill_path}" "${target}"
    fi
  done < <(discover_skills)
}

uninstall_pi() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target current
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}"

    if [[ -L "${target}" ]]; then
      current="$(readlink "${target}")"
      if [[ "${current}" == "${skill_path}" ]]; then
        printf "  - %s\n" "${skill_name}"
        [[ "${dry_run}" == "true" ]] || rm "${target}"
      else
        printf "  ? %s (symlink, but not ours — skipping)\n" "${skill_name}" >&2
      fi
    fi
  done < <(discover_skills)

  if [[ -d "${target_dir}" ]] && [[ -z "$(ls -A "${target_dir}" 2>/dev/null)" ]]; then
    printf "  - %s (empty)\n" "${target_dir}"
    [[ "${dry_run}" == "true" ]] || rmdir "${target_dir}"
  fi
}

install_cursor() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target description
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.mdc"
    description="$(extract_description "${skill_path}/SKILL.md")"

    printf "  + %s.mdc\n" "${skill_name}"
    [[ "${dry_run}" == "true" ]] && continue

    {
      printf -- "---\n"
      printf "description: %s\n" "${description}"
      printf "alwaysApply: true\n"
      printf -- "---\n\n"
      printf "%s\n\n" "${marker}"
      extract_body "${skill_path}/SKILL.md"
    } > "${target}"
  done < <(discover_skills)
}

uninstall_cursor() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.mdc"

    if [[ -f "${target}" ]] && grep -qF "${marker}" "${target}"; then
      printf "  - %s.mdc\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || rm "${target}"
    fi
  done < <(discover_skills)

  if [[ -d "${target_dir}" ]] && [[ -z "$(ls -A "${target_dir}" 2>/dev/null)" ]]; then
    printf "  - %s (empty)\n" "${target_dir}"
    [[ "${dry_run}" == "true" ]] || rmdir "${target_dir}"
  fi
}

install_copilot() {
  local target_dir="$1"
  local dry_run="$2"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.instructions.md"

    printf "  + %s.instructions.md\n" "${skill_name}"
    [[ "${dry_run}" == "true" ]] && continue

    {
      printf -- "---\n"
      printf 'applyTo: "**"\n'
      printf -- "---\n\n"
      printf "%s\n\n" "${marker}"
      extract_body "${skill_path}/SKILL.md"
    } > "${target}"
  done < <(discover_skills)
}

uninstall_copilot() {
  local target_dir="$1"
  local dry_run="$2"

  local skill_path skill_name target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    target="${target_dir}/${skill_name}.instructions.md"

    if [[ -f "${target}" ]] && grep -qF "${marker}" "${target}"; then
      printf "  - %s.instructions.md\n" "${skill_name}"
      [[ "${dry_run}" == "true" ]] || rm "${target}"
    fi
  done < <(discover_skills)

  if [[ -d "${target_dir}" ]] && [[ -z "$(ls -A "${target_dir}" 2>/dev/null)" ]]; then
    printf "  - %s (empty)\n" "${target_dir}"
    [[ "${dry_run}" == "true" ]] || rmdir "${target_dir}"
  fi
}

main() {
  local do_claude=false
  local do_pi=false
  local do_cursor=false
  local do_copilot=false
  local claude_dir=""
  local pi_dir=""
  local cursor_dir=""
  local copilot_dir=""
  local uninstall=false
  local dry_run=false
  local any_flag=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude)
        do_claude=true
        any_flag=true
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          claude_dir="$(expand_tilde "$1")"
          shift
        fi
        ;;
      --pi)
        do_pi=true
        any_flag=true
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          pi_dir="$(expand_tilde "$1")"
          shift
        fi
        ;;
      --cursor)
        do_cursor=true
        any_flag=true
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          cursor_dir="$(expand_tilde "$1")"
          shift
        fi
        ;;
      --copilot)
        do_copilot=true
        any_flag=true
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          copilot_dir="$(expand_tilde "$1")"
          shift
        fi
        ;;
      --all)
        do_claude=true
        do_pi=true
        do_cursor=true
        do_copilot=true
        any_flag=true
        shift
        ;;
      --uninstall)
        uninstall=true
        shift
        ;;
      --dry-run)
        dry_run=true
        shift
        ;;
      --help|-h)
        usage
        return 0
        ;;
      *)
        printf "Error: unknown option '%s'\n" "$1" >&2
        usage >&2
        return 1
        ;;
    esac
  done

  # Bare invocation (or only --uninstall/--dry-run): default to Claude.
  if [[ "${any_flag}" == "false" ]]; then
    do_claude=true
  fi

  # Append the tool-specific subdir to DIR (or use cwd if no DIR was given).
  # Pi's discovery contract uses two different subpaths: ~/.pi/agent/skills/
  # for user-level (only when ~ is explicitly passed) and .pi/skills/ for
  # project-level (any other DIR, or cwd as default).
  local base
  base="${claude_dir:-$(pwd)}"; claude_dir="${base}/.claude/skills"
  base="${pi_dir:-$(pwd)}"
  if [[ -n "${pi_dir}" && "${base}" == "${HOME}" ]]; then
    pi_dir="${base}/.pi/agent/skills"
  else
    pi_dir="${base}/.pi/skills"
  fi
  base="${cursor_dir:-$(pwd)}";  cursor_dir="${base}/.cursor/rules"
  base="${copilot_dir:-$(pwd)}"; copilot_dir="${base}/.github/instructions"

  local action="Installing"
  [[ "${uninstall}" == "true" ]] && action="Uninstalling"
  [[ "${dry_run}" == "true" ]] && action="${action} (dry-run)"

  if [[ "${do_claude}" == "true" ]]; then
    printf "%s skills for Claude Code: %s\n" "${action}" "${claude_dir}"
    if [[ "${uninstall}" == "true" ]]; then
      uninstall_claude "${claude_dir}" "${dry_run}"
    else
      install_claude "${claude_dir}" "${dry_run}"
    fi
  fi

  if [[ "${do_pi}" == "true" ]]; then
    printf "%s skills for Pi: %s\n" "${action}" "${pi_dir}"
    if [[ "${uninstall}" == "true" ]]; then
      uninstall_pi "${pi_dir}" "${dry_run}"
    else
      install_pi "${pi_dir}" "${dry_run}"
    fi
  fi

  if [[ "${do_cursor}" == "true" ]]; then
    printf "%s skills for Cursor: %s\n" "${action}" "${cursor_dir}"
    if [[ "${uninstall}" == "true" ]]; then
      uninstall_cursor "${cursor_dir}" "${dry_run}"
    else
      install_cursor "${cursor_dir}" "${dry_run}"
    fi
  fi

  if [[ "${do_copilot}" == "true" ]]; then
    printf "%s skills for Copilot: %s\n" "${action}" "${copilot_dir}"
    if [[ "${uninstall}" == "true" ]]; then
      uninstall_copilot "${copilot_dir}" "${dry_run}"
    else
      install_copilot "${copilot_dir}" "${dry_run}"
    fi
  fi
}

main "$@"
