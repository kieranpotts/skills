#!/usr/bin/env bash

#
# Install skills into AI agents: Claude Code, Pi, Cursor, GitHub Copilot.
#
# Select agents with --claude, --pi, --cursor, --copilot, or --all.
# These parameters do not accept values.
#
# The target directory is set once via --dir. It defaults to ~
# (user-level install). Pass any other path for a project-level install.
#
# Every install first compiles agent-specific artifacts into ./build/:
# Claude/Pi as verbatim copies of each skill directory; Cursor (.mdc) and
# Copilot (.instructions.md) as generated files with the right frontmatter.
# All four agents then install from ./build/:
#
#   - Default → hard copies of ./build/ artifacts. The target remains
#     self-contained and unaffected by later repo changes.
#   - --symlinks → symlinks into ./build/. Rebuilds (eg. after editing a
#     skill) are picked up immediately. Useful when developing skills.
#
# Cursor and Copilot may not auto-discover user-level skills. The script
# warns at the end of the run if either was installed at ~.
#
# See `--help` for more guidance.
#

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

repo_root="$(cd "${script_dir}/.." && pwd)"
readonly repo_root

readonly skills_dir="${repo_root}/skills"
readonly build_dir="${repo_root}/build"
readonly marker="<!-- Generated by kieranpotts/skills installer. -->"
readonly copy_marker_file=".kp-skills-installer"

usage() {
  cat <<'EOF'
Usage: ./run/install [OPTIONS]

Install skills for AI agents. At least one agent flag (--claude, --pi,
--cursor, --copilot, or --all) is required.

Options:
  --claude              Install for Claude Code.
  --pi                  Install for Pi.
  --cursor              Install for Cursor.
  --copilot             Install for Copilot.
  --all                 Install for all four agents.
  --dir DIR             Target directory for all selected agents. Defaults
                        to ~ (user-level). Use any other path for a
                        project-level install. A leading ~ is expanded
                        to $HOME.
  --symlinks            Install as symlinks instead of copies. Local edits
                        to skills are picked up immediately by new agent
                        sessions. Useful for evaluating skills during
                        development.
  --uninstall           Remove installs. Combine with target flags.
  --dry-run             Print outcomes without performing them.
  --help, -h            Show this help.

Target paths (relative to DIR):
  Claude:    DIR/.claude/skills/
  Pi:        DIR/.pi/skills/ (project) or ~/.pi/agent/skills/ (when DIR is ~)
  Cursor:    DIR/.cursor/rules/
  Copilot:   DIR/.github/instructions/

Notes:
  - Every install first compiles per-agent artifacts into ./build/ (in the
    repo root). By default, the built artifacts are hard-copied into the
    target DIR. Pass --symlinks to create symlinks back to the built
    artifacts in this repository, instead.
  - Copied skills are independent of the source repo. Changes (or even
    deletion) of the repo don't affect already-installed skills.
  - Re-run `./run/install` to refresh installed skills from the latest source.
  - Symlink installs pick up changes immediately on the next install run.
    Use this for fast evaluation of skills during their development.
  - Cursor and Copilot typically only auto-discover skills in project
    directories. They are still installed when DIR is ~, but the installer
    prints a warning at the end of its run.
  - Uninstall only removes files this installer previously created
    (symlinks pointing into ./build/, copies bearing our marker file, or
    generated files containing our marker comment).

Examples:
  ./run/install --claude                       # Claude, user-level copies.
  ./run/install --claude --dir .               # Claude, copies into cwd.
  ./run/install --claude --symlinks            # Claude, user-level symlinks (dev mode).
  ./run/install --all                          # All four, user-level copies.
  ./run/install --all --dir ~/dev/my-project   # All four, copies into a specific project.
  ./run/install --all --symlinks               # All four, user-level symlinks.
  ./run/install --uninstall --claude           # Remove Claude user-level install.
  ./run/install --uninstall --all --dir .      # Remove all four agents' installs from cwd.
EOF
}

discover_skills() {
  find "${skills_dir}" -mindepth 2 -maxdepth 2 -name SKILL.md -printf '%h\n' | sort
}

extract_description() {
  local skill_md="$1"
  awk '
    /^---$/ { c++; next }
    c == 1 && /^description:/ {
      sub(/^description:[[:space:]]*/, "")
      print
      exit
    }
  ' "${skill_md}"
}

extract_body() {
  local skill_md="$1"
  awk '
    BEGIN { c = 0 }
    /^---$/ { c++; next }
    c >= 2 { print }
  ' "${skill_md}"
}

expand_tilde() {
  local path="$1"
  case "${path}" in
    \~)    printf "%s" "${HOME}" ;;
    \~/*)  printf "%s/%s" "${HOME}" "${path:2}" ;;
    *)     printf "%s" "${path}" ;;
  esac
}

prune_empty_dir() {
  local dir="$1"
  local dry_run="$2"
  if [[ -d "${dir}" ]] && [[ -z "$(ls -A "${dir}" 2>/dev/null)" ]]; then
    printf "  - %s (empty)\n" "${dir}"
    [[ "${dry_run}" == "true" ]] || rmdir "${dir}"
  fi
}

# Build all four agents' artifacts into ./build/. Wipes the build dir
# first (preserving build/README.md) so removed skills don't leave stale
# artifacts behind. Claude and Pi artifacts are verbatim copies of the
# source skill directories. Cursor (.mdc) and Copilot (.instructions.md)
# artifacts are generated, with proprietary frontmatter prepended and a
# marker comment so the installer can identify its own files later.
#
build_artifacts() {
  local dry_run="$1"

  if [[ "${dry_run}" == "true" ]]; then
    printf "Building artifacts (dry-run) → %s\n" "${build_dir}"
    return 0
  fi

  printf "Building artifacts → %s\n" "${build_dir}"

  # Wipe everything except the README, then recreate the per-agent dirs.
  find "${build_dir}" -mindepth 1 -maxdepth 1 ! -name 'README.md' -exec rm -rf {} +
  mkdir -p "${build_dir}/claude" "${build_dir}/pi" \
           "${build_dir}/cursor" "${build_dir}/copilot"

  local skill_path skill_name description
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    description="$(extract_description "${skill_path}/SKILL.md")"

    cp -R "${skill_path}" "${build_dir}/claude/${skill_name}"
    cp -R "${skill_path}" "${build_dir}/pi/${skill_name}"

    {
      printf -- "---\n"
      printf "description: %s\n" "${description}"
      printf "alwaysApply: true\n"
      printf -- "---\n\n"
      printf "%s\n\n" "${marker}"
      extract_body "${skill_path}/SKILL.md"
    } > "${build_dir}/cursor/${skill_name}.mdc"

    {
      printf -- "---\n"
      printf 'applyTo: "**"\n'
      printf -- "---\n\n"
      printf "%s\n\n" "${marker}"
      extract_body "${skill_path}/SKILL.md"
    } > "${build_dir}/copilot/${skill_name}.instructions.md"

    # Copy assets/, references/, scripts/ for flat-file agents so that
    # relative links in skill bodies resolve correctly at the target.
    for subdir in assets references scripts; do
      if [[ -d "${skill_path}/${subdir}" ]]; then
        mkdir -p "${build_dir}/copilot/${subdir}" "${build_dir}/cursor/${subdir}"
        cp -R "${skill_path}/${subdir}/." "${build_dir}/copilot/${subdir}/"
        cp -R "${skill_path}/${subdir}/." "${build_dir}/cursor/${subdir}/"
      fi
    done
  done < <(discover_skills)
}

# Is `target` a hard copy that this installer previously created?
# Detects both directory copies (Claude/Pi: marker file inside) and file
# copies (Cursor/Copilot: marker comment inside).
#
is_our_copy() {
  local target="$1"
  if [[ -d "${target}" && -f "${target}/${copy_marker_file}" ]]; then
    return 0
  fi
  if [[ -f "${target}" ]] && grep -qF "${marker}" "${target}" 2>/dev/null; then
    return 0
  fi
  return 1
}

# Is `target` a symlink that this installer previously created (points
# at the expected build artifact)?
#
is_our_symlink() {
  local source="$1" target="$2"
  [[ -L "${target}" ]] && [[ "$(readlink "${target}")" == "${source}" ]]
}

# Write a build artifact at `target` as a hard copy. Drops the marker
# file for directory artifacts so we can identify our own copies later;
# file artifacts already carry the marker comment from the build step.
#
do_write_copy() {
  local source="$1" target="$2"
  if [[ -d "${source}" ]]; then
    cp -R "${source}" "${target}"
    : > "${target}/${copy_marker_file}"
  else
    cp "${source}" "${target}"
  fi
}

# Remove an existing target (either a symlink, a directory copy, or a
# file copy). Caller must have verified ownership.
#
do_remove() {
  local target="$1"
  if [[ -L "${target}" || -f "${target}" ]]; then
    rm "${target}"
  elif [[ -d "${target}" ]]; then
    rm -rf "${target}"
  fi
}

# Install a build artifact as a symlink at `target`. Replaces any
# existing install that we own — including a previous hard copy — so
# the user can switch modes by re-running with --symlinks.
#
install_one_symlink() {
  local source="$1" target="$2" name="$3" dry_run="$4"

  if is_our_symlink "${source}" "${target}"; then
    printf "  = %s (already linked)\n" "${name}"
    return
  fi

  if [[ -L "${target}" ]]; then
    printf "  ~ %s (updating symlink)\n" "${name}"
    [[ "${dry_run}" == "true" ]] || ln -sfn "${source}" "${target}"
    return
  fi

  if is_our_copy "${target}"; then
    printf "  ~ %s (replacing copy with symlink)\n" "${name}"
    [[ "${dry_run}" == "true" ]] || {
      do_remove "${target}"
      ln -sfn "${source}" "${target}"
    }
    return
  fi

  if [[ -e "${target}" ]]; then
    printf "  ! %s (skipping — exists and is not ours)\n" "${name}" >&2
    return
  fi

  printf "  + %s\n" "${name}"
  [[ "${dry_run}" == "true" ]] || ln -sfn "${source}" "${target}"
}

uninstall_one_symlink() {
  local source="$1" target="$2" name="$3" dry_run="$4"

  if is_our_symlink "${source}" "${target}"; then
    printf "  - %s\n" "${name}"
    [[ "${dry_run}" == "true" ]] || rm "${target}"
  elif [[ -L "${target}" ]]; then
    printf "  ? %s (symlink, but not ours — skipping)\n" "${name}" >&2
  fi
}

# Install a build artifact as a hard copy at `target`. Replaces any
# existing install that we own — including a previous symlink — so the
# user can switch modes by re-running without --symlinks. Handles both
# directory artifacts (Claude/Pi) and file artifacts (Cursor/Copilot).
#
install_one_copy() {
  local source="$1" target="$2" name="$3" dry_run="$4"

  if is_our_symlink "${source}" "${target}"; then
    printf "  ~ %s (replacing symlink with copy)\n" "${name}"
    [[ "${dry_run}" == "true" ]] || {
      do_remove "${target}"
      do_write_copy "${source}" "${target}"
    }
    return
  fi

  if [[ -L "${target}" ]]; then
    printf "  ! %s (skipping — exists as a symlink, not ours)\n" "${name}" >&2
    return
  fi

  if is_our_copy "${target}"; then
    printf "  ~ %s (refreshing copy)\n" "${name}"
    [[ "${dry_run}" == "true" ]] || {
      do_remove "${target}"
      do_write_copy "${source}" "${target}"
    }
    return
  fi

  if [[ -e "${target}" ]]; then
    printf "  ! %s (skipping — exists and is not ours)\n" "${name}" >&2
    return
  fi

  printf "  + %s\n" "${name}"
  [[ "${dry_run}" == "true" ]] || do_write_copy "${source}" "${target}"
}

uninstall_one_copy() {
  local target="$1" name="$2" dry_run="$3"

  if is_our_copy "${target}"; then
    printf "  - %s\n" "${name}"
    [[ "${dry_run}" == "true" ]] || do_remove "${target}"
  elif [[ -e "${target}" || -L "${target}" ]]; then
    printf "  ? %s (exists, but not ours — skipping)\n" "${name}" >&2
  fi
}

# Per-agent driver: iterate skills, compute source (in build/) and
# target paths, and dispatch to the symlink or copy primitive.
#
install_agent() {
  local build_subdir="$1" target_dir="$2" suffix="$3" mode="$4" dry_run="$5"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  local skill_path skill_name artifact source target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    artifact="${skill_name}${suffix}"
    source="${build_dir}/${build_subdir}/${artifact}"
    target="${target_dir}/${artifact}"

    if [[ "${mode}" == "symlinks" ]]; then
      install_one_symlink "${source}" "${target}" "${artifact}" "${dry_run}"
    else
      install_one_copy "${source}" "${target}" "${artifact}" "${dry_run}"
    fi
  done < <(discover_skills)
}

uninstall_agent() {
  local build_subdir="$1" target_dir="$2" suffix="$3" mode="$4" dry_run="$5"

  local skill_path skill_name artifact source target
  while IFS= read -r skill_path; do
    skill_name="$(basename "${skill_path}")"
    artifact="${skill_name}${suffix}"
    source="${build_dir}/${build_subdir}/${artifact}"
    target="${target_dir}/${artifact}"

    if [[ "${mode}" == "symlinks" ]]; then
      uninstall_one_symlink "${source}" "${target}" "${artifact}" "${dry_run}"
    else
      uninstall_one_copy "${target}" "${artifact}" "${dry_run}"
    fi
  done < <(discover_skills)

  prune_empty_dir "${target_dir}" "${dry_run}"
}

# Install shared asset directories (assets/, references/, scripts/) for
# flat-file agents (Copilot, Cursor). These are copied into the same target
# directory as the skill instruction files so relative links resolve.
#
install_agent_assets() {
  local build_subdir="$1" target_dir="$2" mode="$3" dry_run="$4"

  [[ "${dry_run}" == "true" ]] || mkdir -p "${target_dir}"

  for subdir in assets references scripts; do
    local source="${build_dir}/${build_subdir}/${subdir}"
    [[ -d "${source}" ]] || continue
    local target="${target_dir}/${subdir}"

    if [[ "${mode}" == "symlinks" ]]; then
      install_one_symlink "${source}" "${target}" "${subdir}" "${dry_run}"
    else
      install_one_copy "${source}" "${target}" "${subdir}" "${dry_run}"
    fi
  done
}

uninstall_agent_assets() {
  local build_subdir="$1" target_dir="$2" mode="$3" dry_run="$4"

  for subdir in assets references scripts; do
    local source="${build_dir}/${build_subdir}/${subdir}"
    local target="${target_dir}/${subdir}"

    if [[ "${mode}" == "symlinks" ]]; then
      uninstall_one_symlink "${source}" "${target}" "${subdir}" "${dry_run}"
    else
      uninstall_one_copy "${target}" "${subdir}" "${dry_run}"
    fi
  done
}

main() {
  # No arguments → show help and exit 0.
  if [[ $# -eq 0 ]]; then
    usage
    return 0
  fi

  local do_claude=false
  local do_pi=false
  local do_cursor=false
  local do_copilot=false
  local dir=""
  local symlinks=false
  local uninstall=false
  local dry_run=false
  local any_flag=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude)
        do_claude=true; any_flag=true; shift ;;
      --pi)
        do_pi=true; any_flag=true; shift ;;
      --cursor)
        do_cursor=true; any_flag=true; shift ;;
      --copilot)
        do_copilot=true; any_flag=true; shift ;;
      --all)
        do_claude=true; do_pi=true; do_cursor=true; do_copilot=true
        any_flag=true; shift ;;
      --dir)
        shift
        if [[ $# -eq 0 ]]; then
          printf "Error: --dir requires a path argument.\n" >&2
          return 1
        fi
        dir="$(expand_tilde "$1")"
        shift ;;
      --symlinks)
        symlinks=true; shift ;;
      --uninstall)
        uninstall=true; shift ;;
      --dry-run)
        dry_run=true; shift ;;
      --help|-h)
        usage; return 0 ;;
      *)
        printf "Error: unknown option '%s'\n" "$1" >&2
        usage >&2
        return 1
        ;;
    esac
  done

  # At least one agent flag is required. --uninstall and --dry-run alone
  # are not enough to do anything useful, so error out with the help text.
  if [[ "${any_flag}" == "false" ]]; then
    printf "Error: at least one agent flag is required (--claude, --pi, --cursor, --copilot, or --all).\n\n" >&2
    usage >&2
    return 1
  fi

  # --dir defaults to $HOME (user-level install).
  dir="${dir:-${HOME}}"

  # Compute per-tool target paths. Pi's discovery contract uses two
  # different subpaths: ~/.pi/agent/skills/ for user-level and
  # .pi/skills/ for any other (project-level) DIR.
  local claude_target="${dir}/.claude/skills"
  local pi_target
  if [[ "${dir}" == "${HOME}" ]]; then
    pi_target="${dir}/.pi/agent/skills"
  else
    pi_target="${dir}/.pi/skills"
  fi
  local cursor_target="${dir}/.cursor/rules"
  local copilot_target="${dir}/.github/instructions"

  local action="Installing"
  [[ "${uninstall}" == "true" ]] && action="Uninstalling"
  [[ "${dry_run}" == "true" ]] && action="${action} (dry-run)"

  # Default install mode is hard copies of the build artifacts. Pass
  # --symlinks to install symlinks back into ./build/ instead — useful
  # when actively developing skills (rebuilds propagate immediately).
  local mode="copies"
  [[ "${symlinks}" == "true" ]] && mode="symlinks"

  local action_fn="install_agent"
  [[ "${uninstall}" == "true" ]] && action_fn="uninstall_agent"

  # Rebuild artifacts before installing. Uninstall doesn't need the build
  # tree (it removes by ownership check, not by content).
  if [[ "${uninstall}" == "false" ]]; then
    build_artifacts "${dry_run}"
    printf "\n"
  fi

  if [[ "${do_claude}" == "true" ]]; then
    printf "%s skills for Claude Code (%s): %s\n" "${action}" "${mode}" "${claude_target}"
    "${action_fn}" "claude" "${claude_target}" "" "${mode}" "${dry_run}"
  fi

  if [[ "${do_pi}" == "true" ]]; then
    printf "%s skills for Pi (%s): %s\n" "${action}" "${mode}" "${pi_target}"
    "${action_fn}" "pi" "${pi_target}" "" "${mode}" "${dry_run}"
  fi

  if [[ "${do_cursor}" == "true" ]]; then
    printf "%s skills for Cursor (%s): %s\n" "${action}" "${mode}" "${cursor_target}"
    "${action_fn}" "cursor" "${cursor_target}" ".mdc" "${mode}" "${dry_run}"
    if [[ "${uninstall}" == "false" ]]; then
      install_agent_assets "cursor" "${cursor_target}" "${mode}" "${dry_run}"
    else
      uninstall_agent_assets "cursor" "${cursor_target}" "${mode}" "${dry_run}"
    fi
  fi

  if [[ "${do_copilot}" == "true" ]]; then
    printf "%s skills for Copilot (%s): %s\n" "${action}" "${mode}" "${copilot_target}"
    "${action_fn}" "copilot" "${copilot_target}" ".instructions.md" "${mode}" "${dry_run}"
    if [[ "${uninstall}" == "false" ]]; then
      install_agent_assets "copilot" "${copilot_target}" "${mode}" "${dry_run}"
    else
      uninstall_agent_assets "copilot" "${copilot_target}" "${mode}" "${dry_run}"
    fi
  fi

  # Warn at the end if Cursor or Copilot were targeted at $HOME — those
  # agents may not auto-discover user-level skills.
  if [[ "${dir}" == "${HOME}" && "${uninstall}" == "false" ]]; then
    local subjects=""
    if [[ "${do_cursor}" == "true" && "${do_copilot}" == "true" ]]; then
      subjects="Cursor and Copilot"
    elif [[ "${do_cursor}" == "true" ]]; then
      subjects="Cursor"
    elif [[ "${do_copilot}" == "true" ]]; then
      subjects="Copilot"
    fi
    if [[ -n "${subjects}" ]]; then
      printf "\nWarning: %s may not auto-discover user-level skills (~). The files have been written but may not be picked up automatically.\n" "${subjects}" >&2
    fi
  fi
}

main "$@"
